# Copy to .env and adjust. .env is gitignored. Never commit real paths to evidence or credentials.

# Root of the generated/working data directories (default: ./data).
LEGAL_DATA_DIR=./data

# Directory holding the ORIGINAL evidence copies. Treated as strictly read-only by the application.
LEGAL_ORIGINALS_DIR=./data/originals

# Append-only audit log location (default: ./logs/audit.jsonl).
LEGAL_AUDIT_LOG=./logs/audit.jsonl

# OCR (tesseract.js) runs locally and offline. The English model ships with the npm package
# @tesseract.js-data/eng. For other languages, put <lang>.traineddata.gz files in one directory
# and set OCR_LANG_PATH to it, e.g. OCR_LANGS=eng+fra.
OCR_ENABLED=true
OCR_LANGS=eng
OCR_LANG_PATH=./node_modules/@tesseract.js-data/eng/4.0.0_best_int

# Local API/UI (Milestone 5). Binds to localhost only unless explicitly changed.
API_HOST=127.0.0.1
API_PORT=8787

# Semantic retrieval: auto | transformers | ollama | lsa | none (see config/app.yaml).
# SEMANTIC_PROVIDER=auto
# SEMANTIC_MODEL=all-MiniLM-L6-v2

# Optional generative answers (default: none = deterministic extractive answers).
# LLM_PROVIDER=ollama
# LLM_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=            # only for openai-compatible servers; never logged

# External LLMs are OFF by default. Document content is never sent to a third-party API
# unless this switch is explicitly set to true AND a provider is configured (Milestone 3+).
ALLOW_EXTERNAL_LLM=false
