{
  "name": "legal-evidence-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first proof of concept for legal evidence ingestion, retrieval and analysis with strict provenance.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node scripts/ensure-deps.mjs && tsx scripts/launch.ts",
    "start:sample": "tsx scripts/launch.ts --sample",
    "setup-models": "tsx scripts/setup-models.ts",
    "search": "tsx scripts/search.ts",
    "ask": "tsx scripts/ask.ts",
    "mcp": "tsx scripts/mcp.ts",
    "eval": "tsx scripts/run-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "ingest": "tsx scripts/ingest.ts",
    "corpus": "tsx scripts/show-corpus.ts",
    "check-originals": "tsx scripts/check-originals.ts",
    "correct": "tsx scripts/correct-metadata.ts",
    "sample-corpus": "tsx scripts/make-sample-corpus.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "@tesseract.js-data/eng": "^1.0.0",
    "cfb": "^1.2.2",
    "commander": "^15.0.0",
    "jszip": "^3.10.2",
    "mailparser": "^3.9.38",
    "mammoth": "^1.13.0",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.4.299",
    "tar": "^7.5.22",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "docx": "^9.9.0",
    "pdfkit": "^0.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tesseract.js": false
  }
}
